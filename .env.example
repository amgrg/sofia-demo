# Sofia demo — variabili d'ambiente di esempio.
# Copia questo file in `.env` e modifica se necessario.
# Tutte le variabili hanno default sensati: per il demo locale puoi anche non usare il .env.

SOFIA_HOST=127.0.0.1
SOFIA_PORT=8000

# Cambia in produzione!
SOFIA_SECRET_KEY=cambia-questa-chiave-in-produzione-sofia-demo
SOFIA_JWT_EXPIRE_MINUTES=1440

# Admin di default (creato dal seed la prima volta)
SOFIA_ADMIN_EMAIL=admin@sofiaai.it
SOFIA_ADMIN_PASSWORD=admin1234

# DB SQLite (default: data/sofia.db)
# SOFIA_DATABASE_URL=sqlite:///./data/sofia.db
